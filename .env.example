# SentinelChain AI - Environment Configuration
# Optional: Provide your Gemini API key to enable online AI generation.
# If omitted, SentinelChain AI operates autonomously in High-Fidelity Local CyberAI Mode.
GEMINI_API_KEY=

# Blockchain Ledger Configuration
LEDGER_STORAGE_PATH=data/blockchain_ledger.json
DIFFICULTY_TARGET=2

# Security & Redaction Options
AUTO_SANITIZE_SECRETS=true
STRICT_CRYPTO_VERIFICATION=true
